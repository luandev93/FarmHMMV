// ============================================================
// prisma/schema.prisma — Módulo Médico (medHMMV)
// Banco: PostgreSQL
// Estratégia: migrações somente aditivas (sem DROP)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Consulta — vinculada ao atendimento da recepção
// Estado: EM_ANDAMENTO → FINALIZADA
// ------------------------------------------------------------
model Consulta {
  id            String    @id @default(uuid())
  atendimentoId String    // ID do atendimento (recepHMMV) — sem FK cruzada entre módulos
  medicoId      String    // ID do médico responsável
  estado        String    @default("EM_ANDAMENTO") // EM_ANDAMENTO | FINALIZADA
  desfecho      String?   // ALTA | INTERNACAO | RETORNO | ENCAMINHAMENTO
  observacao    String?
  correlationId String?
  iniciadaEm    DateTime  @default(now())
  finalizadaEm  DateTime?

  evolucoes     Evolucao[]
  prescricoes   Prescricao[]

  @@index([atendimentoId])
  @@index([medicoId])
  @@map("consultas")
}

// ------------------------------------------------------------
// Evolução SOAP — registros clínicos durante a consulta
// Imutável após criação (sem update/delete pela aplicação)
// ------------------------------------------------------------
model Evolucao {
  id         String   @id @default(uuid())
  consultaId String
  subjetivo  String   // S — queixa principal relatada pelo paciente
  objetivo   String?  // O — dados objetivos (exame físico, sinais vitais)
  avaliacao  String?  // A — diagnóstico / hipótese diagnóstica
  plano      String?  // P — conduta, prescrição, encaminhamento
  criadoPor  String
  criadoEm   DateTime @default(now())

  consulta   Consulta @relation(fields: [consultaId], references: [id])

  @@index([consultaId])
  @@map("evolucoes")
}

// ------------------------------------------------------------
// Prescrição — conjunto de medicamentos para o paciente
// ------------------------------------------------------------
model Prescricao {
  id            String    @id @default(uuid())
  consultaId    String
  estado        String    @default("PENDENTE") // PENDENTE | ENVIADA_FARMACIA | CANCELADA
  criadoPor     String
  correlationId String?
  criadoEm      DateTime  @default(now())

  consulta      Consulta         @relation(fields: [consultaId], references: [id])
  itens         ItemPrescricao[]

  @@index([consultaId])
  @@map("prescricoes")
}

// ------------------------------------------------------------
// Item de Prescrição — medicamento individual da prescrição
// ------------------------------------------------------------
model ItemPrescricao {
  id           String @id @default(uuid())
  prescricaoId String
  medicamento  String
  dose         String
  via          String? // oral, EV, IM, SC, etc.
  frequencia   String? // 8/8h, 12/12h, 1x/dia, etc.
  duracao      String? // 7 dias, uso contínuo, etc.
  observacao   String?

  prescricao   Prescricao @relation(fields: [prescricaoId], references: [id])

  @@map("itens_prescricao")
}

// ------------------------------------------------------------
// Auditoria — log imutável de ações médicas
// REVOKE UPDATE, DELETE ON auditoria FROM app_medico;
// ------------------------------------------------------------
model Auditoria {
  id            String   @id @default(uuid())
  acao          String
  entidade      String
  entidadeId    String?
  usuarioId     String
  funcao        String
  payload       String?
  correlationId String?
  ip            String?
  criadoEm      DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("auditoria")
}
