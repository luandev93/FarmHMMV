# ============================================================
# .env.example — medHMMV
# Copie para .env e preencha os valores reais.
# NUNCA versione .env com credenciais reais.
# ============================================================

NODE_ENV=development
PORT=3002

JWT_SECRET=troque-por-segredo-forte-minimo-32-chars

DATABASE_URL=******localhost:5432/medico_hmmv?schema=public

# API Key recebida por outros módulos neste serviço
MED_API_KEY=chave-api-entre-servicos

# URLs dos módulos dependentes
FARMHMMV_URL=http://localhost:3003
FARMHMMV_API_KEY=chave-api-entre-servicos

RECEPHMMV_URL=http://localhost:3001
RECEPHMMV_API_KEY=chave-api-entre-servicos

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=300

INTEGRATION_MAX_RETRY=3
INTEGRATION_RETRY_DELAY_MS=500
