# ============================================================
# .env.example — recepHMMV
# Copie para .env e preencha os valores reais.
# NUNCA versione o arquivo .env com credenciais reais.
# ============================================================

# Ambiente: development | test | production
NODE_ENV=development

# Porta HTTP do serviço
PORT=3001

# Chave secreta para assinar JWTs (mínimo 32 caracteres em produção)
JWT_SECRET=troque-por-segredo-forte-minimo-32-chars

# Conexão com o banco PostgreSQL
# Formato: ******host:porta/banco?schema=public
DATABASE_URL=******localhost:5432/recepcao_hmmv?schema=public

# URL do módulo médico para integração de eventos
MEDHMMV_URL=http://localhost:3002
MEDHMMV_API_KEY=chave-api-entre-servicos

# CORS — origens permitidas separadas por vírgula
# Deixe vazio para bloquear todas as origens externas
CORS_ORIGINS=http://localhost:5173

# Limite de requisições por janela de 15 minutos por IP
RATE_LIMIT_MAX=300

# Retry de integração
INTEGRATION_MAX_RETRY=3
INTEGRATION_RETRY_DELAY_MS=500
