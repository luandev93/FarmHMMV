rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function logado() {
      return request.auth != null;
    }
    function ativo() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().ativo == true;
    }
    function funcao() {
      return ativo() ? perfil().funcao : 'nenhuma';
    }
    function ehAdm() { return funcao() == 'adm'; }
    function ehFarmaceutico() { return funcao() == 'adm' || funcao() == 'farmaceutico'; }
    function semAdmAinda() {
      return !exists(/databases/$(database)/documents/config/app);
    }

    // Perfis de usuário
    match /usuarios/{uid} {
      // O primeiro usuário do sistema se cadastra como adm (bootstrap).
      allow create: if logado()
                    && request.auth.uid == uid
                    && (semAdmAinda() || ehAdm());
      allow read:   if ativo() || (logado() && request.auth.uid == uid);
      allow update: if ehAdm()
                    || (logado() && request.auth.uid == uid
                        && request.resource.data.funcao == resource.data.funcao
                        && request.resource.data.ativo == resource.data.ativo);
      allow delete: if ehAdm();
    }

    // Configuração geral
    match /config/{doc} {
      allow read:   if logado();
      allow create: if logado() && (semAdmAinda() || ehAdm());
      allow update, delete: if ehAdm();
    }

    // Locais de estoque
    match /estoques/{id} {
      allow read: if ativo();
      allow write: if ehAdm();
    }

    // Catálogo de itens
    match /itens/{id} {
      allow read: if ativo();
      allow write: if ehFarmaceutico();
    }

    // Saldos e lotes: gravados pelo app durante os lançamentos
    match /saldos/{id} {
      allow read: if ativo();
      allow write: if ativo();
    }
    match /lotes/{id} {
      allow read: if ativo();
      allow write: if ativo();
    }

    // Movimentações: imutáveis depois de gravadas
    match /movimentos/{id} {
      allow read:   if ativo();
      allow create: if ativo();
      allow update: if false;
      allow delete: if ehAdm();
    }

    // Auditoria: somente farmacêutico e adm leem
    match /logs/{id} {
      allow read:   if ehFarmaceutico();
      allow create: if ativo();
      allow update, delete: if false;
    }
  }
}
